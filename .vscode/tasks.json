{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend",
      "type": "process",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/apps/web"
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Backend",
      "type": "process",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/apps/api"
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "AI Service",
      "type": "process",
      "command": "${workspaceFolder}\\apps\\ai_service\\venv\\Scripts\\python.exe",
      "args": ["-m", "uvicorn", "main:app", "--reload", "--port", "8000"],
      "options": {
        "cwd": "${workspaceFolder}/apps/ai_service"
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Start All",
      "dependsOn": ["Frontend", "Backend", "AI Service"],
      "dependsOrder": "parallel"
    }
  ]
}
